#!/bin/bash
#
# Pre-commit hook: run Biome's lint over staged src/ files.
#
# Activated by `npm install` via the "prepare" script in package.json, which
# sets git's core.hooksPath to .githooks/. No husky, no extra deps.
#
# Bypass: git commit --no-verify  (use sparingly — the noUndeclaredVariables
# rule has already caught ~17 real bugs; skipping is not free).

set -e

# If config/shared.env.example is part of this commit, stamp it with a fresh
# SHARED_ENV_VERSION (date-based) so downstream installs know their shared.env
# needs updating — the build refuses to run against a stale version and prints
# merge instructions (see scripts/sharedEnvVersion.js). Exit 3 = nothing to do.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx "config/shared.env.example"; then
    bump_status=0
    node scripts/sharedEnvVersion.js --bump-staged || bump_status=$?
    if [ "$bump_status" -eq 0 ]; then
        git add config/shared.env.example
    elif [ "$bump_status" -ne 3 ]; then
        # The script has already explained what is wrong and how to fix it.
        echo ""
        echo "❌ shared.env.example version stamping failed — commit blocked."
        echo "   (bypass with: git commit --no-verify)"
        exit 1
    fi
fi

# Boundary guard for the nested private repository at private/. It is gitignored,
# but `git add -f private` would still stage it as a gitlink (mode 160000), which
# publishes its commit hash and breaks every clone. Also refuse any staged symlink
# that points into private/ from a directory the build copies verbatim (docs/,
# data/, tools/, assets/, sitrecServer/): copy-webpack-plugin and the docs walker
# would dereference it straight into dist/.
while IFS= read -r -d '' staged; do
    case "$staged" in
        private|private/*)
            echo "❌ '$staged' belongs to the private repository and must never be committed here."
            exit 1 ;;
    esac
    mode=$(git ls-files -s -- "$staged" | awk '{print $1}')
    if [ "$mode" = "160000" ]; then
        echo "❌ '$staged' is a gitlink (nested repository). Submodules are not allowed in this repo."
        exit 1
    fi
    if [ "$mode" = "120000" ]; then
        case "$staged" in
            docs/*|data/*|tools/*|assets/*|sitrecServer/*)
                target=$(git cat-file -p "$(git ls-files -s -- "$staged" | awk '{print $2}')")
                case "$target" in
                    private|private/*|*/private|*/private/*)
                        echo "❌ '$staged' is a symlink into private/ inside a directory the build copies."
                        exit 1 ;;
                esac ;;
        esac
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# A checkout may supply its own extra pre-commit checks. If one is present at
# private/githooks/pre-commit it is run here and its exit code decides the
# commit; a plain clone has no such file and this block does nothing.
#
# Deliberately BEFORE the src/-only fast path below, so a local check still sees
# a commit that touches only docs or config.
if [ -x private/githooks/pre-commit ]; then
    private/githooks/pre-commit || exit 1
fi

# Fast path: no files staged under src/ → nothing to lint.
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/.*\.(js|mjs|ts)$' || true)
if [ -z "$STAGED_SRC" ]; then
    exit 0
fi

npm run lint-staged --silent || {
    echo ""
    echo "❌ Lint failed. Fix the issues above, or bypass with:"
    echo "   git commit --no-verify"
    exit 1
}
