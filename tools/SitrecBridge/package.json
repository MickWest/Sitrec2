{
  "name": "sitrec-bridge",
  "version": "1.0.0",
  "description": "MCP server bridging AI coding clients to a running Sitrec instance via Chrome extension",
  "type": "module",
  "bin": {
    "sitrec-bridge": "./mcp-server.js"
  },
  "scripts": {
    "start": "node mcp-server.js",
    "build": "node build-dist.mjs",
    "build:dev": "node build-dist.mjs --dev",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests_browser/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "ip-address": "^10.2.0",
    "@hono/node-server": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
