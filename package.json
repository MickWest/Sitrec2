{
  "name": "sitrec",
  "version": "1.0.0",
  "scripts": {
    "test": "node scripts/runTests.mjs --fits",
    "test-fits": "node scripts/jestFits.mjs --only",
    "test-nofits": "node scripts/runTests.mjs --nofits",
    "need-fit-tests": "node scripts/needFitTests.mjs",
    "test-regression": "node scripts/run-regression-tests.js",
    "test-fast": "node tests_regression/fast-regression/run.mjs",
    "test-fast-update": "node tests_regression/fast-regression/run.mjs --update",
    "test-fast-list": "node tests_regression/fast-regression/run.mjs --list",
    "test-scenarios": "node tests_regression/fast-regression/run-scenarios.mjs",
    "test-scenarios-update": "node tests_regression/fast-regression/run-scenarios.mjs --update-values",
    "test-scenarios-list": "node tests_regression/fast-regression/run-scenarios.mjs --list",
    "pretest-ui": "find tests_regression -name '*.png' -exec xattr -d com.apple.quarantine {} \\; 2>/dev/null || true",
    "test-ui": "npx playwright test",
    "test-ui-headed": "npx playwright test --headed",
    "test-ui-update": "npx playwright test --update-snapshots",
    "test-viewer": "node test-viewer.js",
    "test-viewer-ci": "node test-viewer.js --exit",
    "test-all": "npx jest",
    "test-misb": "node ../test-all-misb-files.js",
    "test-builds": "node test-all-builds.js",
    "test-builds-quick": "node test-all-builds.js --quick",
    "check-three-imports": "node scripts/check-three-imports.js",
    "local-compute-install": "tools/SitrecBridge/local-compute/install.sh",
    "local-compute-install-win": "powershell -ExecutionPolicy Bypass -File tools/SitrecBridge/local-compute/install.ps1",
    "lint": "npx biome lint src/ --only=correctness/noUndeclaredVariables",
    "lint-fix": "npx biome lint src/ --only=correctness/noUndeclaredVariables --write",
    "lint-staged": "node scripts/lint-staged.js",
    "lint-partition": "node deploy/aws/lint/partition-lint.mjs --static-only",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "generate-notices": "npx webpack --config webpack.prod.js --json /tmp/sitrec-webpack-stats.json && node scripts/generateThirdPartyNotices.js --from-stats /tmp/sitrec-webpack-stats.json",
    "generate-notices-quick": "node scripts/generateThirdPartyNotices.js",
    "start": "npx webpack serve --config webpack.dev.js",
    "build": "npx webpack --config webpack.dev.js",
    "deploy": "npx webpack --config webpack.prod.js --json /tmp/sitrec-webpack-stats.json",
    "postdeploy": "node scripts/generateThirdPartyNotices.js --from-stats /tmp/sitrec-webpack-stats.json --copy-to-prod && node scripts/auditBundleSecrets.js --mode=server",
    "copy": "npx webpack --config webpack.copy-files.js",
    "build-standalone": "npx webpack --config webpack.standalone.js",
    "build-standalone-debug": "npx webpack --config webpack.standalone.js --mode development",
    "start-standalone": "node standalone-server.js",
    "start-standalone-debug": "node --inspect standalone-server.js",
    "dev-standalone": "npm run build-standalone && npm run start-standalone",
    "dev-standalone-debug": "npm run build-standalone-debug && npm run start-standalone-debug",
    "build-serverless": "npx webpack --config webpack.serverless.js --mode production --json /tmp/sitrec-webpack-stats.json",
    "build-serverless-debug": "npx webpack --config webpack.serverless.js --mode development",
    "postbuild-serverless": "node scripts/generateThirdPartyNotices.js --from-stats /tmp/sitrec-webpack-stats.json --copy-to dist-serverless && node scripts/auditBundleSecrets.js dist-serverless",
    "postbuild-serverless-debug": "node scripts/auditBundleSecrets.js dist-serverless",
    "start-serverless": "node standalone-serverless.js",
    "start-serverless-debug": "node --inspect standalone-serverless.js",
    "dev-serverless": "npm run build-serverless && npm run start-serverless",
    "dev-serverless-debug": "npm run build-serverless-debug && npm run start-serverless-debug",
    "build-secure": "npx webpack --config webpack.secure.js --mode production --json /tmp/sitrec-webpack-stats.json",
    "postbuild-secure": "node scripts/generateThirdPartyNotices.js --from-stats /tmp/sitrec-webpack-stats.json --copy-to dist-secure && node scripts/auditBundleSecrets.js --mode=secure dist-secure && node scripts/auditBundleEgress.js dist-secure",
    "build-secure-debug": "npx webpack --config webpack.secure.js --mode development",
    "postbuild-secure-debug": "node scripts/auditBundleSecrets.js --mode=secure dist-secure && node scripts/auditBundleEgress.js dist-secure --allow-source-maps",
    "prepare-desktop-build": "node scripts/prepareDesktopBuild.js",
    "promote-desktop-build": "node scripts/promoteDesktopBuild.js",
    "build-desktop": "npm run build-serverless",
    "app-desktop": "npm run build-desktop && cd apps/video-viewer && npm run start",
    "dist-desktop": "npm run prepare-desktop-build && npm run build-desktop && cd apps/video-viewer && npm run build && cd ../.. && npm run promote-desktop-build",
    "dist-desktop-local": "npm run prepare-desktop-build && npm run build-desktop && cd apps/video-viewer && npm run build-local",
    "dist-desktop-local-nosign": "npm run prepare-desktop-build && npm run build-desktop && cd apps/video-viewer && npm run build-local-nosign",
    "dist-desktop-dir-local-nosign": "npm run prepare-desktop-build && npm run build-desktop && cd apps/video-viewer && npm run build-dir-local-nosign",
    "dist-desktop-win": "npm run prepare-desktop-build && npm run build-desktop && cd apps/video-viewer && npm run build-win && cd ../.. && npm run promote-desktop-build",
    "dist-desktop-all": "npm run dist-desktop && npm run dist-desktop-win",
    "postdist-desktop": "node scripts/auditBundleSecrets.js apps_dist/mac-arm64/Sitrec.app",
    "postdist-desktop-win": "node scripts/auditBundleSecrets.js apps_dist/win-unpacked/resources",
    "postdist-desktop-local": "node scripts/auditBundleSecrets.js ${SITREC_DESKTOP_OUTPUT_DIR:-/tmp/sitrec-desktop-builds}/mac-arm64/Sitrec.app",
    "postdist-desktop-local-nosign": "node scripts/auditBundleSecrets.js ${SITREC_DESKTOP_OUTPUT_DIR:-/tmp/sitrec-desktop-builds}/mac-arm64/Sitrec.app",
    "postdist-desktop-dir-local-nosign": "node scripts/auditBundleSecrets.js ${SITREC_DESKTOP_OUTPUT_DIR:-/tmp/sitrec-desktop-builds}/mac-arm64/Sitrec.app",
    "audit-serverless-bundle": "node scripts/auditBundleSecrets.js dist-serverless",
    "audit-secure-bundle": "node scripts/auditBundleSecrets.js --mode=secure dist-secure && node scripts/auditBundleEgress.js dist-secure",
    "audit-prod-bundle": "node scripts/auditBundleSecrets.js --mode=server",
    "audit-desktop-bundle": "node scripts/auditBundleSecrets.js apps_dist/mac-arm64/Sitrec.app",
    "audit-desktop-bundle-win": "node scripts/auditBundleSecrets.js apps_dist/win-unpacked/resources",
    "audit-desktop-bundle-local": "node scripts/auditBundleSecrets.js ${SITREC_DESKTOP_OUTPUT_DIR:-/tmp/sitrec-desktop-builds}/mac-arm64/Sitrec.app",
    "audit-container": "node scripts/auditContainerImage.mjs",
    "audit-release-image": "node scripts/auditReleaseImage.mjs",
    "check-windows-signing": "node scripts/checkWindowsSigningConfig.js",
    "stage-install-downloads": "node scripts/stageDesktopInstallers.js",
    "verify-windows-installer-signature": "node scripts/verifyWindowsAuthenticode.js",
    "version": "node -e \"console.log(require('child_process').execSync('git describe --tags --abbrev=0', {encoding: 'utf8'}).trim())\"",
    "build-video-viewer": "npm run build-desktop",
    "app-video-viewer": "npm run app-desktop",
    "dist-video-viewer": "npm run dist-desktop",
    "bench-losfit": "npx jest benchmarks/losFitting.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot": "npx jest benchmarks/botbench/botbench.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-classify": "npx jest benchmarks/botbench/classify.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-export": "npx jest benchmarks/botbench/export.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-interchange": "npx jest benchmarks/botbench/interchange.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-physics": "npx jest benchmarks/botbench/physics.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-physics-par": "node benchmarks/botbench/run-physics-parallel.mjs",
    "bench-bot-verdict": "npx jest benchmarks/botbench/verdict.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-rate": "npx jest benchmarks/botbench/samplerate.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-capability": "npx jest benchmarks/botbench/capability.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-capval": "npx jest benchmarks/botbench/capability-validation.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-maneuver": "npx jest benchmarks/botbench/maneuver.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-maneuvers": "npx jest benchmarks/botbench/botset-maneuvers.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-maneuvers-par": "node benchmarks/botbench/run-botset-maneuvers.mjs",
    "bench-bot-balloons": "npx jest benchmarks/botbench/botset-balloons.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-platform": "npx jest benchmarks/botbench/botset-platform.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-viz": "node benchmarks/botbench/vizBotBench.mjs",
    "bench-bot-real": "npx jest benchmarks/botbench/realtracks.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-tract": "npx jest benchmarks/botbench/tractability.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-triage": "npx jest benchmarks/botbench/triageFeatures.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit",
    "bench-bot-dossiers": "npx jest benchmarks/botbench/dossiers.bench.test.js --testPathIgnorePatterns /node_modules/ --forceExit"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/test/",
      "<rootDir>/.claude/",
      "<rootDir>/tests_regression/",
      "<rootDir>/test_other/",
      "<rootDir>/dist-standalone/",
      "<rootDir>/dist-serverless/",
      "<rootDir>/dist-secure/",
      "<rootDir>/dist-release-audit/",
      "<rootDir>/dist-audit/",
      "<rootDir>/benchmarks/",
      "<rootDir>/private/",
      "<rootDir>/tools/SitrecBridge/"
    ],
    "roots": [
      "<rootDir>"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist-secure/",
      "<rootDir>/dist-release-audit/"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "\\.[jt]s$": "babel-jest",
      "\\.txt$": "<rootDir>/tests/rawTextTransform.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(3d-tiles-renderer|three/examples)/)"
    ],
    "moduleNameMapper": {
      ".+\\.mjs$": "<rootDir>/tests/__mocks__/three-addons-stub.js",
      "^3d-tiles-renderer/src/(.*)$": "<rootDir>/node_modules/3d-tiles-renderer/src/$1",
      "^3d-tiles-renderer/three$": "<rootDir>/node_modules/3d-tiles-renderer/src/three/renderer/math/OBB.js"
    }
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.2",
    "@mapbox/vector-tile": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "3d-tiles-renderer": "^0.5.2",
    "astronomy-engine": "^2.1.19",
    "buffer": "^6.0.3",
    "chrono-node": "^2.10.1",
    "egm96-universal": "^1.1.1",
    "exifr": "^7.1.3",
    "express-rate-limit": "^8.7.0",
    "file-saver": "^2.0.5",
    "geotiff": "^2.1.3",
    "heic-to": "^1.5.2",
    "i18next": "^26.4.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "jsurl": "^0.1.5",
    "jszip": "^3.10.1",
    "mathjs": "^15.2.0",
    "mediabunny": "^1.55.5",
    "ndarray": "^1.1.1",
    "pbf": "^5.1.2",
    "proj4-fully-loaded": "^0.2.0",
    "regression": "^2.0.1",
    "satellite.js": "^6.0.1",
    "seedrandom": "^3.0.5",
    "stats.js": "^0.17.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@wasm-tool/wasm-pack-plugin": "^1.7.0",
    "babel-jest": "^30.5.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "circular-dependency-plugin": "^5.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "dotenv-webpack": "^8.1.1",
    "esbuild-loader": "^4.5.0",
    "express": "^5.2.1",
    "html-webpack-plugin": "^5.6.8",
    "http-proxy-middleware": "^3.0.3",
    "iwer": "^2.3.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "jsdom": "^30.0.1",
    "markdown-it": "^14.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.2",
    "webpack": "^5.110.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^6.0.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "@hono/node-server": "^2.0.5"
  }
}
