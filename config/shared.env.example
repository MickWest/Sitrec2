# Sitrec shared.env configuration file for installation specific settings
# using in JS code like: process.env.MAPBOX_TOKEN
# and in PHP code like: getenv('MAPBOX_TOKEN')
# variables not used by JS will not be in the JS environment

# Version stamp of this example file (date-based; bumped automatically by the
# pre-commit hook whenever the example's content changes). The build compares
# it against the SHARED_ENV_VERSION in your shared.env and stops with upgrade
# instructions if yours is older. After merging new settings into your
# shared.env, set its SHARED_ENV_VERSION to match this value.
SHARED_ENV_VERSION=2026-09-03

# If no terrain server is available, set this to true
# NO_TERRAIN=true

# If you don't want to use the docs on GitHub (in the help menu), then set this to true
# For example, if you have a local copy of the docs that is fixed to a specific version
# or you can't access the internet from the server
# I enable this by default now, as I have a clean conversion of the md files to HTML
# Disabling it will mean the docs redirect to GitHub
LOCAL_DOCS=true

# Name of the local development server, like "localhost" or "local.metabunk.org"
# the latter form is preferred so you can use referrer based authentication
# For example, with MapTiler, or S3 CORS
LOCALHOST="local.metabunk.org"

# optional banners above and below the browser window
#BANNER_ACTIVE=true
BANNER_TOP_TEXT="NOTIFICATION MESSAGE"
BANNER_BOTTOM_TEXT="NOTIFICATION MESSAGE"
BANNER_COLOR="#FFFFFF"
BANNER_BACKGROUND_COLOR="#377e22"
BANNER_HEIGHT=20
BANNER_TEXT_HEIGHT=16
BANNER_FONT="Arial"

# Override version number, which will prevent fetching it from git (like if you are building from a zip)
# I suggest if you do this, you still include the tag/release from GitHub that you used.
#VERSION=Custom-0.1.0

# Default map tile source for fresh installs. ESRI needs no API key or local caching, so
# it's most likely to work out of the box. Production installs should set this to the source
# they want — e.g. mapbox, maptiler, or one of your own custom sources (CustomMap_<NAME>, see
# "Custom Map Sources" below). Built-in types: mapbox, maptiler, osm, eox, NRL_WMS, NRL_WMTS,
# RGBTest, OceanSurface, Debug, Local, ESRI. Can be overridden on a per-sitch basis.
# NOTE: this is the one knob you normally set — it applies to ALL deploy types, INCLUDING the
# Docker image. (DOCKER_MAP_TYPE below is an optional Docker-only override.)
DEFAULT_MAP_TYPE=ESRI

# Optional override used ONLY by Docker/container deploys (e.g. for CORS differences).
# Leave it commented out to use DEFAULT_MAP_TYPE on Docker too; uncomment only if Docker
# genuinely needs a different default than your other deploys.
#DOCKER_MAP_TYPE=ESRI

# Default elevation source. "Flat" is always safe (flat tiles, needs no internet). "Local"
# uses your own z/x/y tiles under sitrec-terrain/elevation (set correct minZoom/maxZoom/
# tileSize; see this.elevationSources in CNodeTerrainUI.js). For no-internet installs use
# Flat, Local, or a CustomElevation_<NAME> (see below). Same rule as the map type:
# DEFAULT_ELEVATION_TYPE applies to all deploys including Docker.
DEFAULT_ELEVATION_TYPE=AWS_Terrarium

# Optional Docker-only override; leave commented to use DEFAULT_ELEVATION_TYPE on Docker.
#DOCKER_ELEVATION_TYPE=AWS_Terrarium

# Where the "Local" map and elevation sources fetch their z/x/y tiles from, in SERVERLESS
# builds only (server builds get this from config_paths.php). The default is
# "../sitrec-terrain/" — a SIBLING of the app directory, which is what the desktop server and
# a normal local install expect. Set this when the app is published as a single directory with
# nothing above it, such as a GitHub Pages project site at "/<repo>/": there "../" escapes the
# published site and every Local tile 404s. Point it at a mirror inside the app directory, or
# at any other origin that serves the same imagery/<set>/z/y/x.jpg + elevation/z/x/y.png layout.
#SITREC_TERRAIN_URL=./sitrec-terrain/

# Root path for Xenforo authentication (remove if not used)
# XENFORO_PATH=/srv/www/metabunk.org/public_html/

# Default user ID when no auth server (e.g. XenForo) is configured.
# On a closed system where everyone should have access, set this to a non-zero ID (e.g. 1).
# Defaults to 0 (not logged in) if not set.
SITREC_DEFAULT_USERID=1

# Default user groups when using SITREC_DEFAULT_USERID.
# Comma-separated group IDs: admin=3, registered=2, sitrec=14, verified=9
# Defaults to "3,2,14,9" (all groups) if not set.
# SITREC_DEFAULT_USER_GROUPS=3,2,14,9

# Optional: force SitRec login redirects to a specific XenForo origin.
# If unset, SitRec uses the current page origin (recommended for mirrors).
# Example for production split-host deployments:
# SITREC_FORUM_ORIGIN="https://www.metabunk.org"

# What file-saving systems are available
SAVE_TO_SERVER=true

# AWS S3 will override SAVE_TO_SERVER
SAVE_TO_S3=false

# use new presigned URL scheme for S3 saving
USE_S3_PRESIGNED_URLS=true

# S3 Upload configuration vars
# Multipart upload threshold in MB (files larger than this use multipart)
S3_MULTIPART_THRESHOLD_MB=40

# Chunk size for multipart uploads in MB
S3_CHUNK_SIZE_MB=16

# Number of parallel uploads for multipart
S3_PARALLEL_UPLOADS=8

# Presigned URL expiry settings in seconds
# GET URLs used when resolving stored sitrec object refs for loading
S3_PRESIGNED_GET_EXPIRY_SECONDS=1800
# Single-part PUT URLs used for direct uploads
S3_PRESIGNED_PUT_EXPIRY_SECONDS=900
# Multipart UploadPart URLs
S3_PRESIGNED_MULTIPART_EXPIRY_SECONDS=3600

# Object read visibility policy (used by object.php resolver)
# public (default): unsigned stable URLs for most objects, presigned only for private prefixes
# private: presigned by default, unless key matches S3_PUBLIC_PREFIXES
S3_DEFAULT_VISIBILITY=public

# Comma-separated key prefixes treated as private when default visibility is public.
# Example: "1/Private/,2/Secrets/"
S3_PRIVATE_PREFIXES=

# Comma-separated key prefixes treated as public when default visibility is private.
S3_PUBLIC_PREFIXES=

# Optional public URL base (e.g. CloudFront/custom CDN domain) for public objects.
# If empty, public URLs use the bucket virtual-hosted S3 URL.
S3_PUBLIC_BASE_URL=

# ACL to apply at upload time for public/private objects in S3 mode.
S3_PUBLIC_OBJECT_ACL=public-read
S3_PRIVATE_OBJECT_ACL=private

# SAVE_TO_LOCAL is in addition to one (or none) of the above
# But you could disable it if you don't want to allow the user to save to their local disk
SAVE_TO_LOCAL=true

# limit the size of files that can be uploaded to the server
# for filesystem uploads this will be enforced by PHP settings too
# for S3 uploads you can set this as high as you like
# but you will be limited by the browser capabilities
# and your machine's memory and network speed
# so a practical limit is about 2000 MB
MAX_FILE_SIZE_MB=100

# Optional: higher file upload limit for admin users (group 3).
# If set, admins use this limit instead of MAX_FILE_SIZE_MB.
# ADMIN_MAX_FILE_SIZE_MB=2000

# enable the chatbot (likely will want remove it for non-Metabunk installs)
# note for simple OpenAI, there's a key below
# it's not currently configurable for a custom LLM, but if you want then
# you can replace chatbot.php with your own.
CHATBOT_ENABLED=false

# If the platform model cannot be determined from inspecting the data
# then this model will be used
# if undefined (or not found in the models list in CNode3DObjects.js/ModelFiles)
# then it will use the default geometry (a sphere)
DEFAULT_PLATFORM_MODEL="MQ-9 (clean)"

# Set if we are allowed to use cookies for settings
SETTINGS_COOKIES_ENABLED=true

# Set if we can save the setting on the server
# This will use either the server filesystem or S3, depending on the other settings above
SETTINGS_SERVER_ENABLED=true

# Set if we can use the IndexedDB for settings
# SETTINGS_DB_ENABLED=true


# Set to true to use the CUSTOM_TLE below
# Like all SITREC_ prefixed vars, this is exposed as a client-side env var
# If set, it will call proxyStarlink.php with the date in YYYY-MM-DD format as the "request" parameter
# and the type=CUSTOM, like:
# /sitrecServer/proxyStarlink.php?request=2022-09-18&type=CUSTOM

# SITREC_USE_CUSTOM_TLE=true
SITREC_CUSTOM_TLE_MENU_NAME="Custom Satellite TLE"
SITREC_CUSTOM_TLE_TOOLTIP="Fetches Satellite TLE data for the specified date from Somewhere"

# server-side TLE settings as a PHP sprintf format string that will have day, month, year integers passed to it
# this calls the public Celestrak Starlink supplemental TLEs, with a faked date parameter
# Note that Celestrak does not actually support this parameter, so it will always return the current TLEs
# This is just a sample of how to set up a custom TLE source
CUSTOM_TLE="https://celestrak.org/NORAD/elements/supplemental/sup-gp.php?FILE=starlink&FORMAT=tle?FAKEDATE={YYYY}-{MM}-{DD}"

# if you have a more complex TLE source, you can add a function
# getTLECustom() in config/config.php that returns the url string

# set this if you want it to cache the custom TLEs on the server
# as is done for space-track TLEs
# This is recommended if the source is slow or has rate limits, it will cache them permanently (one per date)
# CACHE_CUSTOM_TLE=true


# Set to true to add a custom wind data source to the Wind Data dropdown.
# Like all SITREC_ prefixed vars, this is exposed as a client-side env var.
# When enabled, the client calls customWindProxy.php with date/hour/level parameters,
# the proxy substitutes them into CUSTOM_WIND_URL below, fetches the JSON, and returns it.

# SITREC_USE_CUSTOM_WIND=true
SITREC_CUSTOM_WIND_MENU_NAME="Custom Wind"
SITREC_CUSTOM_WIND_TOOLTIP="Fetches wind grid JSON from your own server"

# Server-side URL template. Placeholders: {YYYY} {MM} {DD} {HH} {LEVEL}
# {LEVEL} is "10m" for surface, or "<n>hPa" for pressure levels (e.g. "850hPa", "500hPa")
# — same encoding as tools/fetch_wind.py.
# The endpoint MUST return earth.nullschool-format JSON:
#   { "nx": 360, "ny": 181, "lon0": 0, "lat0": 90, "dlon": 1, "dlat": -1,
#     "u": [...], "v": [...], "refTime": "...", "source": "MyWX", "level": "850hPa" }
# (`u` and `v` are flat arrays of length nx*ny, row-major from north to south.)
CUSTOM_WIND_URL="https://wx.example.com/grid?date={YYYY}{MM}{DD}&hour={HH}&level={LEVEL}"

# Set this if you want the proxy to cache custom wind responses to disk
# (in data/wind/, alongside GFS cache files). Permanent cache, one per date/hour/level.
# Recommended if the source is slow, rate-limited, or you want offline replay.
# CACHE_CUSTOM_WIND=true

########################################################################################
# Custom Map Sources
# Define custom map tile sources using env vars with a name segment:
#   SITREC_CUSTOM_MAP_<NAME>_URL, _NAME, _MAX_ZOOM, _MIN_ZOOM, _MAPPING, _ATTRIBUTION, _TERMS_URL,
#   _ZOFFSET, _WATER_COLOR
# <NAME> becomes the source key (e.g., ESRI -> key "CustomMap_ESRI" in the dropdown).
# URL template uses {z}, {x}, {y} placeholders (note: ESRI uses z/y/x order, most others use z/x/y).
# _ZOFFSET (integer, default 0) is ADDED to the tile zoom z before it is substituted into the
#   {z} placeholder; e.g. _ZOFFSET=-1 requests one zoom level coarser. 0 is a no-op. Use it when
#   a source's tiling is offset by a fixed amount from Sitrec's standard slippy-map zoom.
# _MIN_ZOOM (integer, default 0) is the lowest zoom Sitrec will request from this source; below
#   it the terrain shows a placeholder tile instead of making a request. A negative _ZOFFSET
#   automatically raises the effective minimum (to at least -_ZOFFSET), so the value going into
#   {z} can never be negative — you do NOT need to set _MIN_ZOOM just to make a negative _ZOFFSET safe.
# _MAPPING (EPSG number, default 3857 = web mercator) selects the tile projection, like a config.js
#   source's `mapping`. Set 4326 for equirectangular / CRS84 sources (e.g. a WMTS GoogleCRS84Quad
#   layer). The map and elevation sources in use must share the same mapping.
# _WATER_COLOR is the flat colour this source paints water with, as "170,211,223" or "#AAD3DF".
#   The Water Reflection effect (Effects -> Water Reflection) finds water by matching the map
#   texture against this colour, so a source without one gets no reflections. The standard OSM
#   tile servers (tile.openstreetmap.org, tile.osm.org, including via cachemaps.php) are
#   recognised by URL and get OSM's #AAD3DF automatically — set this only for a self-hosted or
#   restyled OSM whose water is a different colour. Satellite imagery has no flat water colour;
#   leave it unset there and use Water Reflection's "Vector Water Mask" or "Combine Terrain with
#   OSM" instead. An unparseable value is ignored rather than trusted: an OSM tile server still
#   gets its automatic colour, and any other source is left with none (reflections stay off).
# You can define as many custom map sources as you like — just use different <NAME> segments.
# To make one the default, set DEFAULT_MAP_TYPE=CustomMap_<NAME> above (this works on all
# deploys including Docker — you do NOT need to also set DOCKER_MAP_TYPE).
#
# Example — ESRI World Imagery:
# SITREC_CUSTOM_MAP_ESRI_URL="https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
# SITREC_CUSTOM_MAP_ESRI_NAME="ESRI CUSTOM"
# SITREC_CUSTOM_MAP_ESRI_MAX_ZOOM=20
# SITREC_CUSTOM_MAP_ESRI_ATTRIBUTION="Powered by Esri"
# SITREC_CUSTOM_MAP_ESRI_TERMS_URL="https://www.esri.com/en-us/legal/terms/data-attributions"
# SITREC_CUSTOM_MAP_ESRI_ZOFFSET=0     # add this many zoom levels to {z} (default 0)
# SITREC_CUSTOM_MAP_ESRI_MIN_ZOOM=0    # lowest zoom level to request (default 0)
#
# Example — OpenStreetMap (water reflections work with no _WATER_COLOR: the host is recognised):
# SITREC_CUSTOM_MAP_OSM_URL="https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
# SITREC_CUSTOM_MAP_OSM_NAME="OpenStreetMap"
# SITREC_CUSTOM_MAP_OSM_MAX_ZOOM=17
# SITREC_CUSTOM_MAP_OSM_ATTRIBUTION="© OpenStreetMap contributors"
#
# Example — a self-hosted OSM-style renderer, which must declare its own water colour:
# SITREC_CUSTOM_MAP_HOUSE_URL="https://tiles.example.org/osm/{z}/{x}/{y}.png"
# SITREC_CUSTOM_MAP_HOUSE_NAME="House Style"
# SITREC_CUSTOM_MAP_HOUSE_MAX_ZOOM=19
# SITREC_CUSTOM_MAP_HOUSE_WATER_COLOR="#AAD3DF"   # or "170,211,223"
#
# Example — NRL WMTS (an equirectangular / EPSG:4326 source; note _MAPPING=4326 and {z}/{y}/{x}):
# SITREC_CUSTOM_MAP_NRL_URL="https://geoint.nrlssc.org/nrltileserver/wmts/1.0.0/BlueMarble_AUTO/default/GoogleCRS84Quad/{z}/{y}/{x}.jpg"
# SITREC_CUSTOM_MAP_NRL_NAME="NRL WMTS"
# SITREC_CUSTOM_MAP_NRL_MAPPING=4326
# SITREC_CUSTOM_MAP_NRL_MAX_ZOOM=12
# SITREC_CUSTOM_MAP_NRL_ATTRIBUTION="U.S. Naval Research Laboratory"

########################################################################################
# Custom Elevation Sources
# Same pattern: SITREC_CUSTOM_ELEVATION_<NAME>_URL, _NAME, _MAX_ZOOM, _MIN_ZOOM, _ATTRIBUTION, _TERMS_URL, _MAPPING, _ZOFFSET
# Tiles are assumed to be Terrarium-encoded PNGs (elevation = (R*256 + G + B/256) - 32768)
# unless _MAPPING is set (e.g., "4326" for WMS/GeoTIFF sources like NationalMap 3DEP).
# _ZOFFSET (integer, default 0) is ADDED to the tile zoom z before {z} substitution, exactly
#   as for custom map sources above. 0 is a no-op.
# _MIN_ZOOM (integer, default 0) is the lowest zoom requested; below it a flat placeholder is
#   used (no request). As for maps, a negative _ZOFFSET auto-raises the effective minimum so
#   {z} never goes negative.
# To make one the default, set DEFAULT_ELEVATION_TYPE=CustomElevation_<NAME> above (works on
# all deploys including Docker — no need to also set DOCKER_ELEVATION_TYPE).
#
# Example — AWS Terrarium:
# SITREC_CUSTOM_ELEVATION_AWS_URL="https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
# SITREC_CUSTOM_ELEVATION_AWS_NAME="AWS Terrarium"
# SITREC_CUSTOM_ELEVATION_AWS_MAX_ZOOM=15
# SITREC_CUSTOM_ELEVATION_AWS_ATTRIBUTION="Elevation: USGS, NOAA & contributors"
# SITREC_CUSTOM_ELEVATION_AWS_TERMS_URL="https://github.com/tilezen/joerd/blob/master/docs/attribution.md"
# SITREC_CUSTOM_ELEVATION_AWS_ZOFFSET=0     # add this many zoom levels to {z} (default 0)
# SITREC_CUSTOM_ELEVATION_AWS_MIN_ZOOM=0    # lowest zoom level to request (default 0)

########################################################################################
# Vector water source (Water Reflection)
# Water Reflection's "Vector Water Mask" and "Water on 3D Tiles" find water from real
# water POLYGONS rather than from the colour of the imagery. They need a server speaking
# the OpenMapTiles schema - a `water` layer of polygons in Mapbox Vector Tile (.pbf)
# format. By default that is MapTiler, using MAPTILER_KEY below.
#
# Set SITREC_VECTOR_WATER_URL to point somewhere else: a self-hosted OpenMapTiles, or
# any other server with the same schema. It is a template in {z}/{x}/{y}. When it is set
# MAPTILER_KEY is not consulted at all, so a deployment with no route to the internet
# needs no account with anyone - which is the case SITREC_ENABLE_DEFAULT_MAP_SOURCES
# below already covers for the basemaps, and this covers for the water.
#
# SITREC_VECTOR_WATER_MAX_ZOOM is the deepest zoom your server actually serves (default
# 14, which is what OpenMapTiles publishes). Getting it too high is not a loud failure:
# the missing tiles 404, a 404 correctly means "no water polygons here", and the water
# silently disappears. Past this zoom the polygons are magnified rather than resampled,
# so the shoreline stays sharp - setting it LOW costs very little.
#
# NOTE: like the custom map sources above, this URL is fetched by the BROWSER and is
# visible to anyone using the site. If your server needs a credential in the URL, it is
# as public as MAPTILER_KEY is, so scope it the same way.
# ATTRIBUTION. OpenMapTiles-schema data is normally derived from OpenStreetMap, which is
# ODbL and must be credited on screen, so a custom source is credited by default as
# "Water: (c) OpenStreetMap contributors" linking to openstreetmap.org/copyright. Set
# these to correct it for your own data. Setting ATTRIBUTION to EMPTY (with the = and
# nothing after it) is honoured as "credit nothing" - only do that if your water data
# genuinely carries no attribution requirement.
#SITREC_VECTOR_WATER_URL=https://tiles.example.org/water/{z}/{x}/{y}.pbf
#SITREC_VECTOR_WATER_MAX_ZOOM=14
#SITREC_VECTOR_WATER_ATTRIBUTION=Water: (c) Example Hydrography Office
#SITREC_VECTOR_WATER_TERMS_URL=https://example.org/terms

########################################################################################
# Restricting to only your own sources (offline / locked-down deploys)
# By default the menus include the built-in map/elevation providers that fetch tiles from
# the internet (ESRI, MapBox, MapTiler, EOX, AWS Terrarium, …). To hide those and offer ONLY
# your custom sources defined above, set these to false. When disabled, the dropdowns keep
# your CustomMap_*/CustomElevation_* sources plus the offline-safe built-ins:
#   Map:        Local, Debug, Flat Shading, Ocean Surface
#   Elevation:  Flat, Local
# Defaults to true (all built-in sources shown). Only an explicit "false" disables.
#SITREC_ENABLE_DEFAULT_MAP_SOURCES=false
#SITREC_ENABLE_DEFAULT_ELEVATION_SOURCES=false

########################################################################################

# You can cusomize the "live" (current) TLE sources used in the satellite menu
# This is a server-side URL use by proxy.php (NOT proxyStarlink.php)
# You can make them the same as the CUSTOM_TLE above if you want to only have one source
# These will override the SITREC_ENABLE_DEFAULT_TLE_SOURCES flag, for those two menu options (which were Celestrack)
# It's likely I'll deprecate the starlink-only source in future versions, still investigating

# NOTE ON FORMAT: use FORMAT=csv, not FORMAT=tle.
# The TLE format cannot express catalog numbers above 99999, and the catalog
# passed that limit on 2026-07-11. CelesTrak leaves those objects out of TLE
# feeds entirely, so a FORMAT=tle URL now returns a silently incomplete
# catalog (as of 2026-08, ~128 Starlinks missing). FORMAT=csv is the CCSDS OMM
# keyword set: no catalog-number limit, full-precision epoch, and slightly
# SMALLER than TLE on the wire. Sitrec parses both, so existing TLE URLs keep
# working - they just can't see the newer satellites.
CURRENT_STARLINK="https://celestrak.org/NORAD/elements/supplemental/sup-gp.php?FILE=starlink&FORMAT=csv"
CURRENT_ACTIVE="https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=csv"

# If you now don't need the default TLE sources (space-track and celestrak)
# then set this to false
SITREC_ENABLE_DEFAULT_TLE_SOURCES=true

# Legacy .tle files already in the cache are zipped in proxyStarlink.php to
# reduce bandwidth; if your implementation can't have the ZipArchive class,
# then remove / set this to false.
# This no longer affects newly downloaded data: that is cached as OMM CSV with
# a pre-built .gz served via Content-Encoding, which the browser decompresses
# itself - no ZipArchive on the server and no JSZip in the client.
TLE_ZIP_ENABLED=true


# Enable tracking usage statistics for AI and tileservers, needs user IDs
SITREC_TRACK_STATS=false

# Enable logging of UI menu-item clicks (timestamp + full menu path) to
# sitrec-upload/ui-stats/, aggregated in the admin dashboard "Top 10" panel.
# Needs user IDs. Gated on both client and server by this flag. Off by default.
LOG_UI_INTERACTIONS=false


########################################################################################
# Keys for external services [EXAMPLES ONLY, NON-WORKING, ADD YOUR OWN]

# Mapbox key is is used client-side, so should be domain locked
MAPBOX_TOKEN=EXAMPLEKEY

# Maptiler key is used client-side, so should be domain locked
MAPTILER_KEY=EXAMPLEKEY

# Spacedata key is used server-side
SPACEDATA_USERNAME=EXAMPLEKEY
SPACEDATA_PASSWORD=EXAMPLEKEY

# AWS S3 keys are used server-side

S3_ACCESS_KEY_ID=EXAMPLEKEY
S3_SECRET_ACCESS_KEY=EXAMPLEKEY
S3_REGION="us-west-2"
S3_BUCKET="sitrec"
# S3_ACL — default ACL for uploaded objects. Leave unset (or empty) for buckets
# with "Bucket Owner Enforced" object ownership, which do not support ACLs.
#S3_ACL="public-read"

# Cesium Ion token for 3D building tiles (OSM Buildings).
#
# Reaches the browser ONLY via rehost.php?getuser, which gates it on group
# membership and remaining daily quota - it is deliberately not built into the
# bundle and not injected into the page. Restrict it in the Ion console to the
# asset you use, and to your origins.
# Get a free token at https://ion.cesium.com/
CESIUM_ION_TOKEN=EXAMPLEKEY

# Google Maps API key for Photorealistic 3D Tiles. This is the BROWSER key.
#
# The 3D Tiles API requires the key on every tile request - the session token
# accompanies it rather than replacing it - so this key is unavoidably visible to
# any user entitled to 3D tiles. It reaches the browser only via
# rehost.php?getuser (group + quota gated), not the bundle and not the page.
#
# Restrict it in the Google console to HTTP referrers for your origins AND to the
# Map Tiles API only, and set a billing budget: referrer restriction stops casual
# reuse from another site, but a Referer header is client-controlled, so it is no
# defence against deliberate use. The budget is the authoritative spend cap.
# Enable the Map Tiles API at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=EXAMPLEKEY

# Optional dedicated SERVER key for Google, used by streetview.php.
#
# When set, the server uses this instead of the browser key and sends no Referer.
# Restrict it BY IP ADDRESS in the Google console - unlike a referrer restriction,
# a caller cannot spoof that. Leave unset to keep using the browser key, which
# works but requires streetview.php to forge a matching Referer.
#GOOGLE_MAPS_SERVER_API_KEY=

# ADSBExchange via RapidAPI, used server-side (proxyADSBx.php)
ADSBX_RAPIDAPI_KEY=EXAMPLEKEY

# OpenAI, used server-side
OPENAI_API=EXAMPLEKEY

# Anthropic, used server-side
ANTHROPIC_API=EXAMPLEKEY

# Google Gemini, used server-side. Set this to enable the Gemini models (e.g. the
# cheap, capable gemini-2.5-flash-lite) in the chatbot model list. If unset, all
# Gemini entries are automatically hidden from the model picker.
# GEMINI_API=EXAMPLEKEY
